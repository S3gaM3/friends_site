# Пароль входа в /admin (обязателен)
ADMIN_PASSWORD=changeme-use-a-strong-password

# Секрет подписи сессии (≥16 символов). В production обязателен отдельно от пароля.
ADMIN_SECRET=change-this-long-random-string

# Канонический URL сайта (без слэша в конце) — для sitemap, robots, Open Graph
NEXT_PUBLIC_SITE_URL=https://dshan.ru

# Верификация вебмастеров (опционально)
YANDEX_VERIFICATION=1875f2932e664494
GOOGLE_SITE_VERIFICATION=
